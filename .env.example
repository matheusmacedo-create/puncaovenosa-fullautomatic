# Supabase — projeto puncaovenosa-fullautomatic (sa-east-1)
# Copie para .env.local e preencha. .env.local NAO vai para o Git.

# Publicas: podem aparecer no bundle do cliente.
NEXT_PUBLIC_SUPABASE_URL=https://lqpnbqislaxzhqkszijg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_T-hfk73P8u6mqNL-zoNTJQ_v5neKHP_

# Secreta: ignora RLS. Use SOMENTE em route handlers / server actions.
# Pegue em Project Settings > API Keys no painel do Supabase.
# NUNCA prefixe com NEXT_PUBLIC_ e nunca commite o valor real.
#
# A integracao Supabase da Vercel injeta essas duas com outros nomes
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY). O app aceita as duas
# convencoes, entao num deploy pela Vercel nao e preciso duplicar nada.
SUPABASE_SECRET_KEY=


# Sobrescreve o modo de pagamento. NA MAIORIA DOS CASOS, DEIXE AUSENTE.
#
# Sem esta variavel o app decide sozinho: enquanto nao houver chave de
# provedor configurada (UNICO_API_KEY), a cobranca e tratada como aprovada,
# porque e o unico modo que funciona — sem provedor, ninguem consegue pagar.
# No dia em que a chave do provedor existir, a simulacao se desliga sozinha.
#
# Use 'true' para forcar a simulacao mesmo com provedor configurado, ou
# 'false' para desligar a simulacao antes de ter provedor (o funil trava na
# tela de pagamento — util so para testar esse bloqueio).
#
# Consulte GET /api/diagnostico para ver o estado atual e o motivo.
SIMULAR_PAGAMENTO=

# --- Unicopag (provedor de pagamento) ---------------------------------
# A presenca de UNICO_API_KEY desliga a simulacao automaticamente e passa a
# cobrar de verdade. Pegue em https://app.unicopag.com > API.
# Segredo: nunca prefixe com NEXT_PUBLIC_ e nunca commite o valor real.
UNICO_API_KEY=

# Opcional. So mude se a Unicopag informar outro endereco.
UNICO_BASE_URL=https://api.cloud.unicopag.com.br

# Endereco publico do site. A Unicopag exige postback_url, e e a partir daqui
# que ele e montado (<site>/api/webhooks/unicopag). Na Vercel, se ausente,
# cai para VERCEL_PROJECT_PRODUCTION_URL. Defina explicitamente quando usar
# dominio proprio.
NEXT_PUBLIC_SITE_URL=

# Libera os controles de conferencia manual na tela de pagamento MESMO com
# cobranca real da Unicopag. Serve para testar o funil inteiro sem pagar,
# vendo o QR Code de verdade.
#
# ATENCAO: com isto ligado, qualquer visitante conclui a inscricao sem pagar.
# Remova antes de receber aluno.
PERMITIR_CONFIRMACAO_MANUAL=

# Preco reduzido para teste operacional, em centavos. Ex.: 10 = R$ 0,10.
#
# Serve para pagar de verdade e conferir o fluxo inteiro sem gastar R$ 249.
# O valor e repartido entre os itens na mesma proporcao do preco real, e a
# tela exibe um aviso de que nao e o preco do curso.
#
# E NEXT_PUBLIC_ de proposito: preco precisa ser o mesmo na tela e na
# cobranca, e mudar exige novo deploy — o que e desejavel, porque preco nao
# deveria mudar sem alguem publicar a mudanca.
#
# NA VERCEL: crie como Non-sensitive, em Production, Preview e Development.
# Variavel marcada como Sensitive nao fica disponivel durante o build, e e no
# build que NEXT_PUBLIC_ e resolvida — o valor viraria undefined e o preco
# voltaria calado para R$ 249, com a variavel aparecendo definida no painel.
#
# REMOVA antes de vender. O diagnostico acusa enquanto estiver definida.
NEXT_PUBLIC_PRECO_TESTE_CENTAVOS=

# Espelhamento das inscricoes numa planilha do Google -----------------------
#
# Ponte provisoria: a secretaria acompanha o que o funil coleta antes de haver
# integracao de verdade com os sistemas dela. Sem as duas variaveis abaixo, o
# espelhamento simplesmente nao acontece.
#
# O passo a passo para publicar o Apps Script esta em docs/planilha-secretaria.gs.
#
# NENHUMA das duas leva NEXT_PUBLIC_, de proposito: a gravacao e feita pelo
# servidor. CPF nao pode transitar pelo navegador rumo a um terceiro, e o token
# nao pode existir no bundle — quem protege a planilha e ele.
#
# A planilha guarda CPF e telefone de alunos reais: deixe-a restrita a quem
# precisa, nunca "qualquer pessoa com o link".
PLANILHA_URL=
PLANILHA_TOKEN=

# Painel da secretaria (/secretaria) ---------------------------------------
#
# Janela de leitura ao vivo do que esta passando pelo funil, ate a integracao
# com os sistemas da secretaria existir. Le direto do banco: nao ha copia para
# sincronizar nem exportacao para agendar.
#
# Sem esta variavel a rota responde 404 — um deploy que nao pediu pelo painel
# nao tem painel para invadir.
#
# Minimo de 16 caracteres, e o painel nao liga com menos. Nao ha como limitar
# tentativas de senha numa pagina exposta na internet sem um lugar para conta-
# las, entao a defesa possivel e exigir que ela seja longa.
#
# SEM NEXT_PUBLIC_: a pagina lista nome, CPF e telefone de alunos reais.
SECRETARIA_SENHA=
