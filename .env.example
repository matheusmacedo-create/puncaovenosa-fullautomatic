# Supabase — projeto puncaovenosa-fullautomatic (sa-east-1)
# Copie para .env.local e preencha. .env.local NAO vai para o Git.

# Publicas: podem aparecer no bundle do cliente.
NEXT_PUBLIC_SUPABASE_URL=https://lqpnbqislaxzhqkszijg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_T-hfk73P8u6mqNL-zoNTJQ_v5neKHP_

# Secreta: ignora RLS. Use SOMENTE em route handlers / server actions.
# Pegue em Project Settings > API Keys no painel do Supabase.
# NUNCA prefixe com NEXT_PUBLIC_ e nunca commite o valor real.
#
# A integracao Supabase da Vercel injeta essas duas com outros nomes
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY). O app aceita as duas
# convencoes, entao num deploy pela Vercel nao e preciso duplicar nada.
SUPABASE_SECRET_KEY=

# Token do webhook de pagamento. Sem ele, POST /api/webhooks/pix responde 501
# em vez de aceitar confirmacao de qualquer origem.
PIX_WEBHOOK_TOKEN=

# Trata a cobranca como aprovada: copiar o codigo PIX ou pagar no cartao
# leva direto para a etapa seguinte. Enquanto a Unico nao esta integrada, e o
# unico jeito de percorrer o funil inteiro.
#
# E variavel de SERVIDOR, lida a cada requisicao: ligar ou desligar tem
# efeito imediato, sem novo deploy. (NEXT_PUBLIC_SIMULAR_PAGAMENTO ainda e
# aceita, mas exigiria rebuild para valer.)
#
# ATENCAO: com isto ligado, qualquer visitante conclui a inscricao sem pagar.
# Use 'true' apenas em ambiente de teste. Em producao, deixe ausente.
SIMULAR_PAGAMENTO=
